TZ=Asia/Shanghai

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=jsmedicine
MYSQL_USER=jsmedicine
MYSQL_PASSWORD=jsmedicine123

REDIS_PORT=6379
REDIS_PASSWORD=redis123456

AUTH_BOOTSTRAP_USERNAME=superadmin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_REAL_NAME=系统超级管理员
AUTH_TOKEN_TTL_SECONDS=7200

# 用户端短信验证码。本地默认建议使用 mock。
APP_USER_AUTH_TOKEN_TTL_SECONDS=7200
APP_USER_AUTH_SMS_CODE_TTL_SECONDS=300
APP_USER_AUTH_SMS_MOCK_ENABLED=true
APP_USER_AUTH_SMS_MOCK_CODE=123456

# 微信小程序登录。
# 本地只调后端链路时，建议先用 mock。
# 如果要在微信开发者工具或真机上走真实 wx.login -> code2Session，
# 改成 WECHAT_MINIAPP_MOCK_ENABLED=false，并填写真实的小程序 AppID / AppSecret。
WECHAT_MINIAPP_MOCK_ENABLED=true
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# 微信开放平台网站扫码登录。
# 开发阶段如仅联调后端 mock 登录链路，可保持 WECHAT_WEB_MOCK_ENABLED=true，
# 此时无需真实网站应用 AppID / AppSecret / 回调地址。
# 上线接入真实微信扫码前，务必改为 false 并补齐真实配置。
WECHAT_WEB_MOCK_ENABLED=true
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

APP_STORAGE_PROVIDER=minio
APP_STORAGE_ENDPOINT=http://127.0.0.1:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin123
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_PRESIGNED_UPLOAD_BASE_URL=
APP_STORAGE_AVATAR_BUCKET_NAME=public
APP_STORAGE_AVATAR_MAX_FILE_SIZE_BYTES=5242880
APP_STORAGE_AVATAR_UPLOAD_URL_TTL_SECONDS=900

NGINX_PORT=8088
