SPRING_PROFILES_ACTIVE=test
TZ=Asia/Shanghai

TEST_DOMAIN=api-test.example.com
TEST_BASE_URL=https://api-test.example.com

APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=18080
JAVA_OPTS=-Xms256m -Xmx512m

DB_NAME=jsmedicine_test
DB_USERNAME=jsmedicine
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_MAX_CONNECTIONS=80
MYSQL_INNODB_BUFFER_POOL_SIZE=268435456

REDIS_PASSWORD=change_me
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_MAX_MEMORY=128mb

AUTH_TOKEN_TTL_SECONDS=7200
APP_USER_AUTH_TOKEN_TTL_SECONDS=7200

# 如需覆盖默认跨域白名单，可显式填写；留空则默认放行 TEST_BASE_URL 和本地常用前端端口。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_EXPOSED_HEADERS=Authorization,Content-Disposition
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=3600
