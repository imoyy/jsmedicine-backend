SPRING_PROFILES_ACTIVE=test
TZ=Asia/Shanghai

# Spring Boot 会通过 application.yaml 自动可选读取项目根目录下的 .env.test。

TEST_DOMAIN=api-test.example.com
TEST_BASE_URL=https://api-test.example.com

APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=18080
JAVA_OPTS=-Xms256m -Xmx512m

DB_NAME=jsmedicine_test
DB_USERNAME=jsmedicine
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_MAX_CONNECTIONS=80
MYSQL_INNODB_BUFFER_POOL_SIZE=268435456

REDIS_PASSWORD=change_me
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_MAX_MEMORY=128mb

AUTH_TOKEN_TTL_SECONDS=7200
APP_USER_AUTH_TOKEN_TTL_SECONDS=7200
APP_USER_AUTH_SMS_CODE_TTL_SECONDS=300
APP_USER_AUTH_SMS_MOCK_ENABLED=true
APP_USER_AUTH_SMS_MOCK_CODE=123456

# 微信小程序登录。共享联调环境如需使用真实 wx.login -> code2Session，必须关闭 mock 并填写 AppID / AppSecret。
# 如果只想在测试环境验证后端分支而不接真实微信，可改为 true。
WECHAT_MINIAPP_MOCK_ENABLED=false
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# 微信开放平台网站扫码登录。
# 共享联调环境如果只是验证后端 mock 链路，可开启 mock 且不填写真实配置；
# 如果要验证真实 PC 站微信扫码，必须关闭 mock 并填写真实网站应用配置。
WECHAT_WEB_MOCK_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=

# 阿里云短信。以下 4 项配置完整时，用户端短信验证码会真实发送；留空时走 mock。
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 如果直接在 .env.test 写中文签名，Spring 会自动修正常见 UTF-8 误读；也可写 Unicode escape。
# 示例：速通互联验证码 = \u901F\u901A\u4E92\u8054\u9A8C\u8BC1\u7801
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=ap-southeast-1
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com

# 如需覆盖默认跨域白名单，可显式填写；留空则默认放行 TEST_BASE_URL 和本地常用前端端口。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_EXPOSED_HEADERS=Authorization,Content-Disposition
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=3600

APP_STORAGE_PROVIDER=minio
APP_STORAGE_ENDPOINT=http://127.0.0.1:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=change_me
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_PRESIGNED_UPLOAD_BASE_URL=https://api-test.example.com/minio
APP_STORAGE_AVATAR_BUCKET_NAME=public
APP_STORAGE_AVATAR_MAX_FILE_SIZE_BYTES=5242880
APP_STORAGE_AVATAR_UPLOAD_URL_TTL_SECONDS=900
